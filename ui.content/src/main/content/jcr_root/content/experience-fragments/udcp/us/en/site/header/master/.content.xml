<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/udcp/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Header"
        sling:resourceType="udcp/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="udcp/components/container"
            layout="simple">
            <universityHeader
                jcr:primaryType="nt:unstructured"
                sling:resourceType="/apps/udcp/components/udcp-components/header"
                logo="/content/experience-fragments/udcp/us/en/site/header/master/_jcr_content/root/logo/logo.svg"
                universityName="Campus Connect University"
                tagline="Learn Beyond Limits. Lead Beyond Boundaries."
                buttonLabel="Join Our Community">
                <navigationLinks jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        label="Home"
                        link="/content/udcp/us/en"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        label="About Us"/>
                    <item2
                        jcr:primaryType="nt:unstructured"
                        label="Academics"
                        link="/content/udcp/us/en/udcp"/>
                    <item4
                        jcr:primaryType="nt:unstructured"
                        label="Faculty"/>
                    <item5
                        jcr:primaryType="nt:unstructured"
                        label="Campus Life"/>
                    <item6
                        jcr:primaryType="nt:unstructured"
                        label="Events"/>
                    <item7
                        jcr:primaryType="nt:unstructured"
                        label="Visit Us"/>
                </navigationLinks>
                <navigation
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="udcp/components/navigation"
                    collectAllPages="false"
                    navigationRoot="/content/udcp/us/en"
                    skipNavigationRoot="false"
                    structureDepth="2"/>
                <languagenavigation
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="udcp/components/languagenavigation"
                    navigationRoot="/content/udcp/us"
                    structureDepth="2"/>
                <search
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="udcp/components/search"
                    searchRoot="/content/udcp/us"/>
            </universityHeader>
        </root>
    </jcr:content>
</jcr:root>
