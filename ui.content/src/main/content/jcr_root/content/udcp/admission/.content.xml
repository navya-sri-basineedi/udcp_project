<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Admission"
        cq:template="/conf/udcp/settings/wcm/templates/udcp-campus-page"
        sling:resourceType="udcp/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="udcp/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="udcp/components/container"
                layout="responsiveGrid">
                <hero
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="udcp/components/udcp-components/hero-banner"
                    backgroundImage="/content/dam/udcp/university.jpg"
                    headline="Begin Your Journey With Us"
                    description="Explore your interests, build your skills and take the next step toward your future."/>
                <admissionContent
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="udcp/components/text"
                    textIsRich="{Boolean}true"
                    text="&lt;div class=&quot;navigation-page-copy navigation-page-copy--admission&quot;&gt;&lt;section class=&quot;navigation-page-section&quot;&gt;&lt;div class=&quot;navigation-page-inner&quot;&gt;&lt;p class=&quot;navigation-page-section__eyebrow&quot;&gt;Why choose us&lt;/p&gt;&lt;h2&gt;A foundation for what comes next&lt;/h2&gt;&lt;div class=&quot;navigation-card-grid navigation-card-grid--four&quot;&gt;&lt;article class=&quot;navigation-card&quot;&gt;&lt;h3&gt;Industry-Relevant Learning&lt;/h3&gt;&lt;p&gt;Develop practical knowledge through learning connected to professional contexts.&lt;/p&gt;&lt;/article&gt;&lt;article class=&quot;navigation-card&quot;&gt;&lt;h3&gt;Supportive Faculty&lt;/h3&gt;&lt;p&gt;Learn with educators who encourage curiosity, progress and thoughtful guidance.&lt;/p&gt;&lt;/article&gt;&lt;article class=&quot;navigation-card&quot;&gt;&lt;h3&gt;Hands-On Experience&lt;/h3&gt;&lt;p&gt;Build skills through projects, collaboration and applied learning opportunities.&lt;/p&gt;&lt;/article&gt;&lt;article class=&quot;navigation-card&quot;&gt;&lt;h3&gt;A Connected Community&lt;/h3&gt;&lt;p&gt;Explore ideas and interests alongside a community of learners and mentors.&lt;/p&gt;&lt;/article&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class=&quot;navigation-page-section navigation-page-section--cream&quot;&gt;&lt;div class=&quot;navigation-page-inner&quot;&gt;&lt;p class=&quot;navigation-page-section__eyebrow&quot;&gt;Your application journey&lt;/p&gt;&lt;h2&gt;Admission Process&lt;/h2&gt;&lt;div class=&quot;navigation-card-grid navigation-card-grid--four&quot;&gt;&lt;article class=&quot;navigation-card&quot;&gt;&lt;h3&gt;1. Explore Programs&lt;/h3&gt;&lt;p&gt;Review the available study areas and identify programs that match your goals.&lt;/p&gt;&lt;/article&gt;&lt;article class=&quot;navigation-card&quot;&gt;&lt;h3&gt;2. Submit Application&lt;/h3&gt;&lt;p&gt;Prepare your information and submit an application through the university's designated process.&lt;/p&gt;&lt;/article&gt;&lt;article class=&quot;navigation-card&quot;&gt;&lt;h3&gt;3. Application Review&lt;/h3&gt;&lt;p&gt;The admissions team reviews submitted materials against program requirements.&lt;/p&gt;&lt;/article&gt;&lt;article class=&quot;navigation-card&quot;&gt;&lt;h3&gt;4. Admission Confirmation&lt;/h3&gt;&lt;p&gt;Applicants are informed of the outcome and any next steps through official channels.&lt;/p&gt;&lt;/article&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class=&quot;navigation-page-section&quot;&gt;&lt;div class=&quot;navigation-page-inner&quot;&gt;&lt;p class=&quot;navigation-page-section__eyebrow&quot;&gt;Programs offered&lt;/p&gt;&lt;h2&gt;Find a field that inspires you&lt;/h2&gt;&lt;div class=&quot;navigation-card-grid navigation-card-grid--programs&quot;&gt;&lt;article class=&quot;navigation-card&quot;&gt;&lt;h3&gt;Engineering&lt;/h3&gt;&lt;p&gt;Explore computing, technology and engineering disciplines.&lt;/p&gt;&lt;/article&gt;&lt;article class=&quot;navigation-card&quot;&gt;&lt;h3&gt;Management&lt;/h3&gt;&lt;p&gt;Build a foundation in business, finance and organizational leadership.&lt;/p&gt;&lt;/article&gt;&lt;article class=&quot;navigation-card&quot;&gt;&lt;h3&gt;Design&lt;/h3&gt;&lt;p&gt;Develop creative practice, visual communication and design skills.&lt;/p&gt;&lt;/article&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class=&quot;navigation-page-section navigation-page-section--cream&quot;&gt;&lt;div class=&quot;navigation-page-inner&quot;&gt;&lt;p class=&quot;navigation-page-section__eyebrow&quot;&gt;Eligibility information&lt;/p&gt;&lt;h2&gt;General eligibility&lt;/h2&gt;&lt;p&gt;Eligibility varies by program and level of study. Applicants are generally expected to meet the academic prerequisites for their chosen program and provide the required supporting documents. Please contact the university's admissions office for current program-specific requirements and official application guidance. No fees or application deadlines are stated here.&lt;/p&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class=&quot;navigation-page-section&quot; id=&quot;enquiry&quot;&gt;&lt;div class=&quot;navigation-page-inner&quot;&gt;&lt;p class=&quot;navigation-page-section__eyebrow&quot;&gt;Enquire about admissions&lt;/p&gt;&lt;h2&gt;Ask us a question&lt;/h2&gt;&lt;p&gt;This frontend-only enquiry form does not transmit or store information.&lt;/p&gt;&lt;div class=&quot;navigation-form-panel&quot;&gt;&lt;form class=&quot;navigation-form&quot; data-frontend-only-form=&quot;enquiry&quot;&gt;&lt;label class=&quot;navigation-form__field&quot; for=&quot;admission-name&quot;&gt;Name&lt;input id=&quot;admission-name&quot; name=&quot;name&quot; type=&quot;text&quot; autocomplete=&quot;name&quot; required&gt;&lt;/label&gt;&lt;label class=&quot;navigation-form__field&quot; for=&quot;admission-email&quot;&gt;Email&lt;input id=&quot;admission-email&quot; name=&quot;email&quot; type=&quot;email&quot; autocomplete=&quot;email&quot; required&gt;&lt;/label&gt;&lt;label class=&quot;navigation-form__field&quot; for=&quot;admission-phone&quot;&gt;Phone&lt;input id=&quot;admission-phone&quot; name=&quot;phone&quot; type=&quot;tel&quot; autocomplete=&quot;tel&quot;&gt;&lt;/label&gt;&lt;label class=&quot;navigation-form__field&quot; for=&quot;admission-program&quot;&gt;Program of Interest&lt;select id=&quot;admission-program&quot; name=&quot;program&quot; required&gt;&lt;option value=&quot;&quot; selected disabled&gt;Select a program area&lt;/option&gt;&lt;option value=&quot;Engineering&quot;&gt;Engineering&lt;/option&gt;&lt;option value=&quot;Management&quot;&gt;Management&lt;/option&gt;&lt;option value=&quot;Design&quot;&gt;Design&lt;/option&gt;&lt;/select&gt;&lt;/label&gt;&lt;label class=&quot;navigation-form__field&quot; for=&quot;admission-message&quot;&gt;Message&lt;textarea id=&quot;admission-message&quot; name=&quot;message&quot; rows=&quot;5&quot; required&gt;&lt;/textarea&gt;&lt;/label&gt;&lt;button class=&quot;navigation-form__submit&quot; type=&quot;submit&quot;&gt;Send Enquiry&lt;/button&gt;&lt;p class=&quot;navigation-form__status&quot; data-form-status role=&quot;status&quot; aria-live=&quot;polite&quot; hidden&gt;&lt;/p&gt;&lt;/form&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class=&quot;navigation-page-callout&quot;&gt;&lt;div class=&quot;navigation-page-inner&quot;&gt;&lt;h2&gt;Your Future Starts Here&lt;/h2&gt;&lt;p&gt;Take time to explore your options and ask our admissions team for current guidance.&lt;/p&gt;&lt;a class=&quot;navigation-page-button&quot; href=&quot;#enquiry&quot;&gt;Plan Your Next Step&lt;/a&gt;&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;"/>
            </container>
        </root>
    </jcr:content>
</jcr:root>
