<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Navigation"
    sling:resourceType="/libs/granite/ui/components/coral/foundation/container">
    <items jcr:primaryType="nt:unstructured">
        <navigationLinks
            jcr:primaryType="nt:unstructured"
            sling:resourceType="/libs/granite/ui/components/coral/foundation/form/multifield"
            composite="{Boolean}true"
            fieldLabel="Navigation Links">
            <field
                jcr:primaryType="nt:unstructured"
                sling:resourceType="/libs/granite/ui/components/coral/foundation/container"
                name="./navigationLinks">
                <items jcr:primaryType="nt:unstructured">
                    <label
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/granite/ui/components/coral/foundation/form/textfield"
                        emptyText="e.g.Home,Courses,Faculty"
                        fieldLabel="Navigation Label"
                        name="./label"
                        required="{Boolean}true"/>
                    <link
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Navigation Link"
                        name="./link"
                        rootPath="/content"/>
                    <parentLabel
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/granite/ui/components/coral/foundation/form/textfield"
                        fieldDescription="Set to Academics for course submenu items; leave blank for top-level links."
                        fieldLabel="Parent Navigation Label (optional)"
                        emptyText="Academics"
                        name="./parentLabel"/>
                </items>
            </field>
        </navigationLinks>
        <signInLink
            jcr:primaryType="nt:unstructured"
            sling:resourceType="/libs/granite/ui/components/coral/foundation/form/pathfield"
            fieldLabel="Sign In Link"
            name="./signInLink"
            rootPath="/content"/>
        <buttonLabel
            jcr:primaryType="nt:unstructured"
            sling:resourceType="/libs/granite/ui/components/coral/foundation/form/textfield"
            emptyText="Join Our Community"
            fieldLabel="Join Our Community Button Label"
            name="./buttonLabel"/>
        <buttonLink
            jcr:primaryType="nt:unstructured"
            sling:resourceType="/libs/granite/ui/components/coral/foundation/form/pathfield"
            fieldLabel="Join Our Community Link"
            name="./buttonLink"
            rootPath="/content"/>
    </items>
</jcr:root>
