<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Events"
    sling:resourceType="/libs/granite/ui/components/coral/foundation/container">
    <items jcr:primaryType="nt:unstructured">
        <heading
            jcr:primaryType="nt:unstructured"
            sling:resourceType="/libs/granite/ui/components/coral/foundation/form/textfield"
            emptyText="Upcoming Campus Events"
            fieldLabel="Section Heading"
            name="./heading"/>
        <events
            jcr:primaryType="nt:unstructured"
            sling:resourceType="/libs/granite/ui/components/coral/foundation/form/multifield"
            composite="{Boolean}true"
            fieldLabel="Upcoming Events">
            <field
                jcr:primaryType="nt:unstructured"
                sling:resourceType="/libs/granite/ui/components/coral/foundation/container"
                name="./events">
                <items jcr:primaryType="nt:unstructured">
                    <eventTitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/granite/ui/components/coral/foundation/form/textfield"
                        emptyText="Enter event title"
                        fieldLabel="Event Title"
                        name="./eventTitle"
                        required="{Boolean}true"/>
                    <eventDate
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/granite/ui/components/coral/foundation/form/datepicker"
                        fieldLabel="Event Date"
                        name="./eventDate"
                        type="date"/>
                    <eventLocation
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/granite/ui/components/coral/foundation/form/textfield"
                        emptyText="e.g.Main Auditorium"
                        fieldLabel="Event Location"
                        name="./eventLocation"/>
                    <eventDescription
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/granite/ui/components/coral/foundation/form/textarea"
                        emptyText="Briefly describe the event"
                        fieldLabel="Event Description"
                        name="./eventDescription"
                        rows="{Long}3"/>
                    <eventLink
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="/libs/granite/ui/components/coral/foundation/form/textfield"
                        emptyText="/content/udcp/us/en/udcp/event-page.html"
                        fieldDescription="Optional page path or URL for the event details."
                        fieldLabel="Event Details Link"
                        name="./eventLink"/>
                </items>
            </field>
        </events>
    </items>
</jcr:root>
